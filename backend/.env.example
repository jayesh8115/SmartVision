# Copy to backend/.env
# For the CIFAR-100 model from Step 2 use: MODEL_BACKEND=custom, INPUT_SIZE=224, PREPROCESS=resnet
MODEL_BACKEND=imagenet            # imagenet (pretrained, 1000 classes) | custom (your .keras file)
MODEL_PATH=models/resnet50_cifar100.keras
LABELS_PATH=models/cifar100_classes.json
INPUT_SIZE=224
PREPROCESS=resnet                 # resnet (preprocess_input) | rescale (x/255) -> must match training
CONF_THRESHOLD=0.40
TOP_K=3
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
USE_S3=false
AWS_REGION=ap-south-1
S3_BUCKET=

# MySQL Database Configuration
DATABASE_URL=mysql+pymysql://smartvision_user:smartvision_secret@localhost:3306/smartvision_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=smartvision_db
MYSQL_USER=smartvision_user
MYSQL_PASSWORD=smartvision_secret
