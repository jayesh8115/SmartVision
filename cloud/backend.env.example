# Copy to cloud/backend.env on the EC2 server. No inline comments (Docker Compose can choke on them).
# MODEL_BACKEND: imagenet (pretrained, 1000 classes) or custom (your .keras file under /srv/models)
MODEL_BACKEND=imagenet
MODEL_PATH=models/resnet50_cifar100.keras
LABELS_PATH=models/cifar100_classes.json
INPUT_SIZE=224
PREPROCESS=resnet
CONF_THRESHOLD=0.40
TOP_K=3
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP
USE_S3=true
AWS_REGION=ap-south-1
S3_BUCKET=YOUR_BUCKET_NAME
